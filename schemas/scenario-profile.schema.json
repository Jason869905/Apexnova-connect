{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.apexnova.dev/connect/scenario-profile.schema.json",
  "title": "Scenario Profile",
  "type": "object",
  "required": ["schemaVersion", "id", "name", "domain", "profileVersion", "requirements", "priorities", "scoringRuleVersion"],
  "properties": {
    "schemaVersion": { "$ref": "common-definitions.schema.json#/$defs/schemaVersion" },
    "id": { "$ref": "common-definitions.schema.json#/$defs/stableId" },
    "name": { "type": "string", "minLength": 1, "maxLength": 160 },
    "description": { "type": "string", "maxLength": 1200 },
    "domain": { "type": "string", "pattern": "^[a-z][a-z0-9]*(?:[.-][a-z0-9]+)*$" },
    "profileVersion": { "type": "string", "minLength": 1, "maxLength": 80 },
    "requirements": { "type": "array", "items": { "$ref": "common-definitions.schema.json#/$defs/capabilityRequirement" } },
    "priorities": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "enum": ["compatibility", "quality", "cost", "latency", "availability", "privacy", "context", "x-custom"] }
    },
    "defaultConstraints": { "type": "object" },
    "applicability": { "type": "string", "maxLength": 1200 },
    "scoringRuleVersion": { "type": "string", "minLength": 1, "maxLength": 80 },
    "updatedAt": { "$ref": "common-definitions.schema.json#/$defs/timestamp" }
  },
  "additionalProperties": false
}
