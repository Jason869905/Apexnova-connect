{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.apexnova.dev/connect/common-definitions.schema.json",
  "title": "Apexnova-connect Common Definitions",
  "$defs": {
    "schemaVersion": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+$"
    },
    "stableId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$",
      "minLength": 3,
      "maxLength": 160
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "protocolId": {
      "description": "Protocol identifiers. The Hub catalog's own vocabulary is authoritative: compatibility evidence subjects carry the value the catalog returns verbatim, so one protocol never appears under two spellings. openai-chat-completions is retained for Agent and Integration declarations, which predate the catalog vocabulary.",
      "type": "string",
      "anyOf": [
        {
          "enum": [
            "openai-responses",
            "openai-chat",
            "openai-chat-completions",
            "anthropic-messages",
            "openai-embeddings",
            "openai-images",
            "apexnova-media-images",
            "apexnova-media-videos"
          ]
        },
        { "pattern": "^x-[a-z0-9]+(?:[.-][a-z0-9]+)+$" }
      ]
    },
    "capabilityId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:[.-][a-z0-9]+)*$",
      "minLength": 2,
      "maxLength": 120
    },
    "capabilityRequirement": {
      "type": "object",
      "required": ["capabilityId", "level"],
      "properties": {
        "capabilityId": { "$ref": "#/$defs/capabilityId" },
        "level": { "enum": ["required", "preferred", "optional", "avoided"] },
        "operator": { "enum": ["supported", "eq", "gte", "lte", "in", "contains"] },
        "value": {},
        "weight": { "type": "number", "minimum": 0, "maximum": 1 },
        "reason": { "type": "string", "maxLength": 500 }
      },
      "additionalProperties": false
    },
    "capabilityStatement": {
      "type": "object",
      "required": ["capabilityId", "support", "sourceType"],
      "properties": {
        "capabilityId": { "$ref": "#/$defs/capabilityId" },
        "support": { "enum": ["supported", "partial", "unsupported", "unknown"] },
        "value": {},
        "unit": { "type": "string", "maxLength": 80 },
        "sourceType": { "enum": ["provider-claim", "official-test", "maintainer-test", "community-test", "runtime-observation"] },
        "evidenceRefs": {
          "type": "array",
          "items": { "$ref": "#/$defs/stableId" },
          "uniqueItems": true
        },
        "observedAt": { "$ref": "#/$defs/timestamp" },
        "expiresAt": { "$ref": "#/$defs/timestamp" },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 }
      },
      "additionalProperties": false
    },
    "money": {
      "type": "object",
      "required": ["amount", "currency"],
      "properties": {
        "amount": { "type": "string", "pattern": "^-?[0-9]+(?:\\.[0-9]+)?$" },
        "currency": { "type": "string", "pattern": "^[A-Z]{3}$" }
      },
      "additionalProperties": false
    }
  }
}
