{
  "name": "apexnova-connect",
  "version": "0.0.0",
  "private": true,
  "description": "Extensible integrations between Apexnova AI Hub and AI agents or automation platforms.",
  "license": "Apache-2.0",
  "type": "module",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=9.15.0"
  },
  "scripts": {
    "build": "pnpm --recursive --if-present run build",
    "check": "pnpm run typecheck && pnpm run test && pnpm run build",
    "cli": "pnpm --filter @apexnova-connect/cli... build && node apps/cli/dist/main.js",
    "test": "pnpm --filter @apexnova-connect/cli... build && vitest run",
    "test:watch": "vitest",
    "probe:hub-h1": "pnpm --filter @apexnova-connect/hub-client... build && node tools/probe-hub-h1.mjs",
    "typecheck": "pnpm --filter @apexnova-connect/cli... build && tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "typescript": "7.0.2",
    "vitest": "4.1.11"
  }
}
